generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Todo {
  id     Int     @id @default(autoincrement())
  title  String
  isDone Boolean
  userId Int
  User   User    @relation(fields: [userId], references: [id])
}

model User {
  id       Int    @id @default(autoincrement())
  username String @db.VarChar(400)
  email    String @unique @db.VarChar(200)
  password String
  Todo     Todo[]
}
